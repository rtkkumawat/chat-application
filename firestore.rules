rules_version = '2';

// Firestore is written and read only by this backend through the Admin SDK,
// which bypasses security rules. Clients get no direct access at all, so chat
// membership (which lives in PostgreSQL) is always enforced by the API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
